    "test:watch": "vitest",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "sample-app": "vite --config examples/sample-app/vite.config.mjs"
  },
  "dependencies": {
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@supabase/supabase-js": "^2.117.3",
