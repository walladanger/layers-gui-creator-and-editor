{
  "name": "layers-gui-creator-and-editor",
  "description": "Reusable React, TypeScript, and Tauri foundation for premium Windows desktop applications.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.json tsconfig.node.json && vite build",
    "build:dev": "vite build --mode development",
